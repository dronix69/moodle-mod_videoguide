    @template mod_videoguide/view_page

    View page template for mod_videoguide.

    Example context (json):
    {
        "displaymethod": "newtab",
        "viewedcount": 1,
        "totalvideos": 3,
        "progresspercent": 33,
        "requiredpending": 1,
        "hasvideos": true,
        "canmanage": false,
        "videos": [
            {
                "id": 1,
                "number": 1,
                "viewed": true,
                "enabled": true,
                "required": true,
                "newtab": true,
                "canembed": true,
                "url": "https://www.youtube.com/watch?v=abc",
                "embedurl": "https://www.youtube-nocookie.com/embed/abc",
                "title": "Introduction",
                "platform": "YouTube",
                "platformclass": "youtube",
                "platformicon": "fa-youtube",
                "description": "Introduction video."
            }
        ]
    }
}}
<div class="videoguide-wrapper" data-displaymethod="{{displaymethod}}">

    {{! Barra de progreso }}
    <div class="videoguide-progress-section mb-4" data-total="{{totalvideos}}">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0">{{#str}}yourprogress, mod_videoguide{{/str}}</h5>
            <span class="d-flex align-items-center">
                <span id="videoguide-required-badge" class="badge badge-warning mr-2 {{^requiredpending}}d-none{{/requiredpending}}" title="{{#str}}requiredpending, mod_videoguide{{/str}}">
                    <i class="fa fa-exclamation-circle mr-1"></i><span id="videoguide-required-count">{{requiredpending}}</span>
                </span>
                <span class="badge badge-primary"><span id="videoguide-viewed-count">{{viewedcount}}</span> / <span id="videoguide-total-count">{{totalvideos}}</span></span>
            </span>
        </div>
        <div class="progress" style="height: 25px;">
            <div id="videoguide-progress-bar" class="progress-bar progress-bar-striped progress-bar-animated bg-success"
                 role="progressbar"
                 style="width: {{progresspercent}}%"
                 aria-valuenow="{{progresspercent}}"
                 aria-valuemin="0"
                 aria-valuemax="100">
                <span id="videoguide-progress-percent">{{progresspercent}}%</span>
            </div>
        </div>
    </div>

    {{! Barra de filtros (solo estudiantes) }}
    {{#hasvideos}}
    <div class="videoguide-toolbar mb-3" role="group" aria-label="{{#str}}filtervideos, mod_videoguide{{/str}}">
        <div class="btn-group btn-group-sm videoguide-filters" role="group">
            <button type="button" class="btn btn-outline-secondary active" data-filter="all" aria-pressed="true">{{#str}}filterall, mod_videoguide{{/str}}</button>
            <button type="button" class="btn btn-outline-secondary" data-filter="pending" aria-pressed="false">{{#str}}filterpending, mod_videoguide{{/str}}</button>
            <button type="button" class="btn btn-outline-secondary" data-filter="required" aria-pressed="false">{{#str}}filterrequired, mod_videoguide{{/str}}</button>
        </div>
        <div class="videoguide-search">
            <div class="input-group input-group-sm">
                <div class="input-group-prepend"><span class="input-group-text"><i class="fa fa-search"></i></span></div>
                <input type="search" id="videoguide-search" class="form-control" placeholder="{{#str}}searchvideos, mod_videoguide{{/str}}" aria-label="{{#str}}searchvideos, mod_videoguide{{/str}}">
            </div>
        </div>
    </div>
    {{/hasvideos}}

    {{! Tabla de videos }}
    {{#hasvideos}}
    <div class="videoguide-table-container">
        <div class="table-responsive">
            <table class="table table-hover videoguide-table">
                <thead class="thead-dark">
                    <tr>
                        <th style="width: 50px;">{{#str}}videonumber, mod_videoguide{{/str}}</th>
                        <th style="width: 70px;">{{#str}}status, mod_videoguide{{/str}}</th>
                        <th>{{#str}}video, mod_videoguide{{/str}}</th>
                        <th style="width: 120px;">{{#str}}platform, mod_videoguide{{/str}}</th>
                        <th>{{#str}}description, mod_videoguide{{/str}}</th>
                        {{#canmanage}}
                        <th style="width: 100px;">{{#str}}visibility, mod_videoguide{{/str}}</th>
                        {{/canmanage}}
                    </tr>
                </thead>
                <tbody>
                    {{#videos}}
                    <tr class="videoguide-row {{#viewed}}table-success viewed-row{{/viewed}} {{^enabled}}table-secondary disabled-row{{/enabled}}"
                        data-videoid="{{id}}"
                        data-viewed="{{#viewed}}1{{/viewed}}{{^viewed}}0{{/viewed}}"
                        data-required="{{#required}}1{{/required}}{{^required}}0{{/required}}"
                        data-canembed="{{#canembed}}1{{/canembed}}{{^canembed}}0{{/canembed}}"
                        data-search="{{title}} {{description}}">

                        {{! Número de orden }}
                        <td class="text-center text-muted">{{number}}</td>

                        {{! Columna de estado (check para estudiante) }}
                        <td class="text-center">
                            <button class="btn btn-sm toggle-view-btn {{#viewed}}btn-success{{/viewed}}{{^viewed}}btn-outline-secondary{{/viewed}}"
                                    data-videoid="{{id}}"
                                    aria-pressed="{{#viewed}}true{{/viewed}}{{^viewed}}false{{/viewed}}"
                                    aria-label="{{#viewed}}{{#str}}marknotviewed, mod_videoguide{{/str}}{{/viewed}}{{^viewed}}{{#str}}markviewed, mod_videoguide{{/str}}{{/viewed}}"
                                    title="{{#viewed}}{{#str}}marknotviewed, mod_videoguide{{/str}}{{/viewed}}{{^viewed}}{{#str}}markviewed, mod_videoguide{{/str}}{{/viewed}}">
                                <i class="fa {{#viewed}}fa-check-circle{{/viewed}}{{^viewed}}fa-circle-o{{/viewed}}" aria-hidden="true"></i>
                            </button>
                        </td>

                        {{! Columna de título y enlace }}
                        <td>
                            <div class="d-flex align-items-center">
                                {{#required}}
                                <span class="badge badge-danger mr-2" title="{{#str}}required, mod_videoguide{{/str}}">!</span>
                                {{/required}}
                                <a href="{{url}}" class="video-link font-weight-bold" data-embedurl="{{embedurl}}" data-title="{{title}}"
                                   {{#newtab}}target="_blank" rel="noopener noreferrer"{{/newtab}}>
                                    {{title}}
                                    {{#newtab}}<i class="fa fa-external-link ml-1" style="font-size: 0.7em;"></i>{{/newtab}}
                                    {{^newtab}}<i class="fa fa-play-circle ml-1" style="font-size: 0.7em;"></i>{{/newtab}}
                                </a>
                                {{^enabled}}
                                <span class="badge badge-secondary ml-2">{{#str}}hidden, mod_videoguide{{/str}}</span>
                                {{/enabled}}
                            </div>
                        </td>

                        {{! Columna de plataforma }}
                        <td>
                            <span class="platform-badge {{platformclass}}">
                                <i class="fa {{platformicon}}"></i>
                                <span class="ml-1">{{platform}}</span>
                            </span>
                        </td>

                        {{! Columna de descripción }}
                        <td class="text-muted">{{{description}}}</td>

                        {{! Columna de visibilidad (solo profesor) }}
                        {{#canmanage}}
                        <td class="text-center">
                            {{#enabled}}
                            <span class="eye-icon active" title="{{#str}}visible, mod_videoguide{{/str}}">
                                <i class="fa fa-eye fa-lg text-success"></i>
                            </span>
                            {{/enabled}}
                            {{^enabled}}
                            <span class="eye-icon inactive" title="{{#str}}hidden, mod_videoguide{{/str}}">
                                <i class="fa fa-eye-slash fa-lg text-muted"></i>
                            </span>
                            {{/enabled}}
                        </td>
                        {{/canmanage}}
                    </tr>
                    {{/videos}}
                </tbody>
            </table>
        </div>
        <div id="videoguide-no-results" class="alert alert-info d-none">
            <i class="fa fa-info-circle"></i> {{#str}}novideosmatch, mod_videoguide{{/str}}
        </div>
    </div>
    {{/hasvideos}}

    {{^hasvideos}}
    <div class="alert alert-info">
        <i class="fa fa-info-circle"></i> {{#str}}novideos, mod_videoguide{{/str}}
    </div>
    {{/hasvideos}}

</div>
